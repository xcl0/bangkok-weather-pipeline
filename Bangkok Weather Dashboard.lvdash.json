{
  "datasets": [
    {
      "name": "8013ba9e",
      "displayName": "daily_temperature",
      "queryLines": [
        "--Daily Average Temperature\r\n",
        "SELECT\r\n",
        "    weather_date,\r\n",
        "    avg_temperature_celsius\r\n",
        "FROM workspace.default.gold_weather_daily\r\n",
        "ORDER BY weather_date;"
      ]
    },
    {
      "name": "336d9b32",
      "displayName": "daily_temperature_summary",
      "queryLines": [
        "-- Compare daily minimum, average, and maximum temperatures\r\n",
        "SELECT\r\n",
        "    weather_date,\r\n",
        "    min_temperature_celsius,\r\n",
        "    avg_temperature_celsius,\r\n",
        "    max_temperature_celsius\r\n",
        "FROM workspace.default.gold_weather_daily\r\n",
        "ORDER BY weather_date;"
      ]
    },
    {
      "name": "c053f08e",
      "displayName": "daily_temperature_range",
      "queryLines": [
        "-- Show the daily difference between maximum and minimum temperature\r\n",
        "SELECT\r\n",
        "    weather_date,\r\n",
        "    temperature_range_celsius\r\n",
        "FROM workspace.default.gold_weather_daily\r\n",
        "ORDER BY weather_date;"
      ]
    }
  ],
